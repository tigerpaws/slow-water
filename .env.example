# Copernicus Data Space Ecosystem OAuth client (free account).
# Create at: dataspace.copernicus.eu → Dashboard → User Settings → OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Commercial Sentinel Hub (sold by Planet; 30-day free trial) — used with --provider planet.
# Create at: apps.sentinel-hub.com/dashboard → User Settings → OAuth clients
PLANET_SH_CLIENT_ID=
PLANET_SH_CLIENT_SECRET=

# Chat assistant (console.anthropic.com). If the key is identity-linked,
# also set the workspace id it should act in (Console → Settings → Workspaces).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
